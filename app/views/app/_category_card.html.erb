<div id="category-card" class="border rounded p-4 bg-white w-full shadow hover:shadow-md transition-shadow duration-300">
  <a href="<%= group_path(category) %>">
    <div class="container flex flex-col sm:flex-row justify-between gap-4">
      <div class="flex gap-4 items-center">
        <ion-icon name="<%= category.icon %>" class="text-5xl"></ion-icon>
        <div class="card-body">
          <h5 class="card-title text-slate-700 font-bold text-lg"><%= category.name %></h5>
          <p class="card-text text-slate-500 text-sm">Transactions: <%= category.transactions_counter %></p>
        </div>
      </div>
      <div class="flex sm:w-1/4 items-center justify-end gap-2 text-right">
        <p class="card-text font-medium">Total: $</p>
        <span class="text-lg font-bold"><%= total_amount %></span>
      </div>
    </div>
  </a>
</div>
