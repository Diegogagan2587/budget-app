<div class="container px-5 w-full max-w-5xl flex flex-col gap-5 mt-10 mx-auto">
  <% @categories.each do |category| %>
    <% @total_amount = category.entities.sum(:amount) %>
    <%= render partial: 'app/category_card', locals: { category: category, total_amount: @total_amount } %>
  <% end %>
</div>
<%= link_to new_group_path, class:"border bg-[#5fb523] text-white p-3 mt-10 w-full sm:w-auto flex justify-center items-center rounded-md shadow hover:shadow-lg" do %>
  <span>New Category</span>
<% end %>
